{
  "uid": "go-rest-api-service-template-logs",
  "title": "go-rest-api-service-template · Logs",
  "description": "The log store: find one request, see what is failing, and read the access log. Every panel here is new -- there was no log dashboard, because there was no log store.",
  "tags": [
    "svc-qu3ry-core",
    "generated"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service_name",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(app_calls_total, service_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "description": "Which service's series to show. One Grafana can serve several deployments, or this service and the template it came from; without this they are summed together silently."
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(app_calls_total{service_name=~\"$service_name\"}, service_instance_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "description": "Which replica. All is the right default -- a per-replica view is for finding the odd one out."
      },
      {
        "name": "trace_id",
        "label": "trace id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "description": "A trace id from a trace view, an error response or a stdout line. Leave empty to match nothing."
      },
      {
        "name": "request_id",
        "label": "request id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "description": "An X-Request-ID value, as returned on every response and quoted in every error body."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "name": "Restarts",
        "target": {
          "expr": "{service_name=~\"$service_name\"} |= `application initialization completed`",
          "refId": "Anno"
        },
        "textFormat": "restarted",
        "titleFormat": "restart"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Stopped on an error",
        "target": {
          "expr": "{service_name=~\"$service_name\"} |= `application stopped on an error`",
          "refId": "AnnoF"
        },
        "textFormat": "stopped on an error",
        "titleFormat": "stopped"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "🔎 Find one request",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "By trace id",
      "description": "Paste a trace id to see every line that request produced, in order, across handler, usecase and repository. This is what the whole logs change was for: before it, no log line knew which request it belonged to.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=~\"$service_name\"} | trace_id=`$trace_id`",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "logs",
      "title": "By request id",
      "description": "The same, from the X-Request-ID a caller was given. Useful when a support ticket quotes the header and not a trace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=~\"$service_name\"} | request_id=`$request_id`",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "📊 Volume and severity",
      "collapsed": false,
      "id": 4,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Volume by severity",
      "description": "TRACE never appears here at any log level: that level carries SQL arguments and LLM request bodies and is stdout-only by design.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (severity_text) (count_over_time({service_name=~\"$service_name\"} [$__auto]))",
          "legendFormat": "{{severity_text}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      }
    },
    {
      "type": "timeseries",
      "title": "Errors by the layer they arose in",
      "description": "ERROR lines by the layer they carry. A request answered 5xx is its access line, under the layer the error arose in and not under every layer it passed through -- the failed rate per layer is on the Layers dashboard. Work outside a request logs in every layer it passes, and a layer may add a line of its own, so this counts lines, not failures. 'no operation' is an error written outside any operation: a middleware, a recovered panic, a library's background worker. app_layer is structured metadata, so this filters on an attribute and does not scan the message text.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (app_layer) (count_over_time({service_name=~\"$service_name\"} | severity_number >= 17 | app_layer != `` [$__auto]))",
          "legendFormat": "{{app_layer}}",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=~\"$service_name\"} | severity_number >= 17 | app_layer = `` [$__auto]))",
          "legendFormat": "no operation",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      }
    },
    {
      "type": "row",
      "title": "🌐 Access log",
      "collapsed": false,
      "id": 7,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "description": "Every request line carries its status. `route != ''` selects the access log and nothing else.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (status) (count_over_time({service_name=~\"$service_name\"} | route != `` [$__auto]))",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      }
    },
    {
      "type": "timeseries",
      "title": "Slowest routes (p95 ms)",
      "description": "p95 latency per ROUTE, from the access log. The route is the mux pattern, so /users/{id} groups; a path would give one series per id. duration_ms is on the line, which it was not before.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=~\"$service_name\"} | route != `` | unwrap duration_ms [$__auto]) by (route)",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      }
    },
    {
      "type": "table",
      "title": "Recent requests",
      "description": "The access log as a table: route, status, duration, client address. The client address is resolved through the trusted-proxy policy, so behind a proxy it is the caller and not the proxy.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=~\"$service_name\"} | route != ``",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "Line": true,
              "id": true,
              "tsNs": true,
              "code_file_path": true,
              "code_function_name": true,
              "code_line_number": true,
              "observed_timestamp": true,
              "scope_name": true,
              "telemetry_sdk_language": true,
              "telemetry_sdk_name": true,
              "telemetry_sdk_version": true,
              "severity_number": true,
              "detected_level": true,
              "flags": true,
              "service_name": true,
              "service_version": true,
              "span_id": true
            },
            "indexByName": {
              "Time": 0,
              "method": 1,
              "route": 2,
              "status": 3,
              "duration_ms": 4,
              "bytes": 5,
              "client_ip": 6,
              "user_agent": 7,
              "request_id": 8,
              "trace_id": 9
            }
          }
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      }
    },
    {
      "type": "row",
      "title": "🚨 Failures",
      "collapsed": false,
      "id": 11,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Where failures arose",
      "description": "The operations that ERROR lines name over the window, most first, with the type of the error. A request answered 5xx is its access line, carrying the operation its error arose in; work outside a request logs operation_failed in every layer it passes, so a reload of the revoked-token mirror that fails in the repository is two rows. A row with no error_type is a line a layer wrote in its own words. A refused request (4xx) is not an error and is not here: see Refused requests. The attributes are flat -- grouped, they would arrive as context_app_layer and disagree with the name the metrics and the span use.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(20, sum by (app_layer, app_domain, app_action, error_type) (count_over_time({service_name=~\"$service_name\"} | severity_number >= 17 | app_layer != `` [$__range])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 39
      }
    },
    {
      "type": "logs",
      "title": "Errors",
      "description": "Click a line to expand its attributes; the trace id links straight to the trace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=~\"$service_name\"} | severity_number >= 17",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 39
      }
    },
    {
      "type": "table",
      "title": "Refused requests",
      "description": "What the service refused over the window, by status and by the type of the error it answered with, the hundred most frequent. A refusal is not an error of the service, so it is on no error panel: it is the access line, at INFO. A row with no error_type was refused without a recorded error: by a middleware (authentication, authorization, project membership, the rate limiter), by the router (no such route), or by a handler that turns down a query parameter itself.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(100, sum by (status, error_type) (count_over_time({service_name=~\"$service_name\"} | route != `` | status >= 400 | status < 500 [$__range])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 48
      }
    }
  ]
}
